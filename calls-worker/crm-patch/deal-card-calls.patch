+const test=require('node:test'),assert=require('node:assert/strict'),{randomUUID:uuid}=require('node:crypto');
+const harness=require('./helpers/crm-workflow-harness.cjs');
+// Синтетические данные: настоящие телефоны, токены и ответы телефонии не используются.
+function setup(phone='0555 000 111'){
+ const h=harness();
+ const client=h.request('save_crm_record',{kind:'client',id:uuid(),version:0,mutation_id:uuid(),data:{name:'Synthetic buyer',phone,role:'buyer',stage:'new',city:'',district:'',property_type:'',rooms:'',budget_min:'',budget_max:'',currency:'USD',notes:''}});
+ assert.equal(client.ok,true,JSON.stringify(client));
+ h.props.CALLS_API_URL='https://calls.example.test/';h.props.CALLS_API_TOKEN='synthetic-token';
+ return {h,client:client.record};
+}
+const plain=value=>JSON.parse(JSON.stringify(value));
+const calls=(h,client_id)=>plain(h.request('list_crm_workflow',{data:{calls:{client_id}}}));
+const json=body=>()=>({getResponseCode:()=>200,getContentText:()=>JSON.stringify(body)});
+
+test('calls: agent email, phone and token go only to the server-side request',()=>{
+ const {h,client}=setup();
+ h.setFetch(json({results:[{id:'1:7',direction:'out',answered:1,start_time:1700000000,duration:75.9,has_recording:true,recording_url:'https://secret.example.test/r.mp3',client_phone:'+996555000111'}]}));
+ const r=calls(h,client.id);
+ assert.equal(r.ok,true,JSON.stringify(r));assert.equal(r.calls_page.status,'ok');
+ assert.deepEqual(r.calls_page.items[0],{id:'1:7',direction:'out',answered:true,started_at:'2023-11-14T22:13:20.000Z',duration:75,has_recording:true});
+ assert.ok(!JSON.stringify(r).includes('secret.example.test'),'recording URL must not reach the browser');
+ assert.equal(h.fetches.length,1);const {url,options}=h.fetches[0];
+ assert.ok(url.startsWith('https://calls.example.test/api/calls?'));
+ assert.ok(url.includes('agent=agent.a%40example.com'));assert.ok(url.includes('client_phone=0555%20000%20111'));
+ assert.equal(options.headers.Authorization,'Bearer synthetic-token');
+});
+test('calls: another agent cannot read a client by id',()=>{
+ const {h,client}=setup();h.setActor('b');
+ const r=calls(h,client.id);
+ assert.equal(r.ok,false);assert.equal(r.error,'crm_client_not_found');assert.equal(h.fetches.length,0);
+});
+test('calls: invalid input is refused before any outgoing request',()=>{
+ const {h}=setup();
+ for(const bad of [null,[],'x',{},{client_id:''},{client_id:'x'.repeat(37)}]){const r=plain(h.request('list_crm_workflow',{data:{calls:bad}}));assert.equal(r.ok,false);assert.equal(r.error,'crm_invalid_fields',JSON.stringify(bad));}
+ assert.equal(calls(h,uuid()).error,'crm_client_not_found');assert.equal(h.fetches.length,0);
+});
+test('calls: unconfigured, no phone and service failures degrade without errors',()=>{
+ const {h,client}=setup();
+ h.props.CALLS_API_URL='http://insecure.example.test';assert.equal(calls(h,client.id).calls_page.status,'not_configured');
+ h.props.CALLS_API_URL='https://calls.example.test';h.props.CALLS_API_TOKEN='';assert.equal(calls(h,client.id).calls_page.status,'not_configured');
+ h.props.CALLS_API_TOKEN='synthetic-token';
+ h.setFetch(()=>({getResponseCode:()=>500,getContentText:()=>'boom'}));assert.equal(calls(h,client.id).calls_page.status,'unavailable');
+ h.setFetch(()=>{throw Error('network');});assert.equal(calls(h,client.id).calls_page.status,'unavailable');
+ h.setFetch(()=>({getResponseCode:()=>200,getContentText:()=>'<html>'}));assert.equal(calls(h,client.id).calls_page.status,'unavailable');
+ const none=setup('');assert.equal(calls(none.h,none.client.id).calls_page.status,'no_phone');assert.equal(none.h.fetches.length,0);
+});
+test('calls: result list is capped and malformed fields are normalised',()=>{
+ const {h,client}=setup();
+ h.setFetch(json({results:Array.from({length:80},(_,i)=>({id:'a:'+i,direction:'weird',answered:0,start_time:'x',duration:-5,has_recording:'yes'}))}));
+ const items=calls(h,client.id).calls_page.items;
+ assert.equal(items.length,50);assert.deepEqual(items[0],{id:'a:0',direction:'in',answered:false,started_at:'',duration:0,has_recording:false});
+});
