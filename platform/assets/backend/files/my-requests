<body data-profile-brand="20261103-personal-brand-1" class="v20 profile-page personal-section-page" data-require-registration="true"><script>(()=>{'use strict';
const key='v20-public-theme',media=matchMedia('(prefers-color-scheme:dark)');
let chosen;try{chosen=localStorage.getItem(key)}catch(_){}
let current=chosen==='dark'||chosen==='light'?chosen:media.matches?'dark':'light';
function apply(value,save=false){current=value==='dark'?'dark':'light';document.documentElement.dataset.theme=current;document.body.dataset.ltTheme=current;document.body.dataset.publicTheme=current;document.body.dataset.v20Theme=current;if(save){chosen=current;try{localStorage.setItem(key,current)}catch(_){}}labels();}
function labels(){const lang=(document.documentElement.lang||'ru').slice(0,2);const words={ru:['Тёмная тема','Светлая тема'],en:['Dark theme','Light theme'],ky:['Караңгы тема','Жарык тема'],zh:['深色模式','浅色模式']};const label=(words[lang]||words.ru)[current==='dark'?1:0];for(const b of document.querySelectorAll('#publicTheme,[data-lt-theme-toggle],.crm-theme-toggle')){b.setAttribute('aria-label',label);b.setAttribute('title',label);b.setAttribute('aria-pressed',String(current==='dark'));if(b.hasAttribute('data-lt-theme-toggle'))b.textContent=label;}}
document.addEventListener('click',event=>{const button=event.target.closest('#publicTheme,[data-lt-theme-toggle],.crm-theme-toggle');if(!button)return;event.preventDefault();event.stopImmediatePropagation();apply(current==='dark'?'light':'dark',true);},true);
window.addEventListener('storage',event=>{if(event.key===key){chosen=event.newValue;apply(chosen==='dark'||chosen==='light'?chosen:media.matches?'dark':'light');}});
media.addEventListener('change',event=>{if(!chosen)apply(event.matches?'dark':'light');});
window.addEventListener('liberterra:languagechange',labels);
apply(current);
document.addEventListener('DOMContentLoaded',()=>{apply(current);new MutationObserver(()=>{const next=document.body.dataset.publicTheme;if(next!==current&&(next==='dark'||next==='light'))apply(next,true);}).observe(document.body,{attributes:true,attributeFilter:['data-public-theme']});},{once:true});
})();
</script>
