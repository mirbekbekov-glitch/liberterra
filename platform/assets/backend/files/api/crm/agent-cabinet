      </label>
      <p class="crm-form-message" data-crm-edit-message role="alert" hidden></p>
      <div class="crm-dialog-actions">
        <button class="crm-secondary-button" type="button" data-crm-dialog-close>Отмена</button>
        <button class="crm-primary-button" type="submit">Сохранить изменения</button>
      </div>
    </form>
  </dialog>

