      <label class="crm-field">
        <span>Цена</span>
        <input name="price" inputmode="decimal" autocomplete="off">
      </label>
      <label class="crm-field">
        <span>Заголовок</span>
        <input name="title" maxlength="240">
      </label>
      <label class="crm-field">
        <span>Район или адрес</span>
        <input name="district" maxlength="240">
      </label>
      <label class="crm-field">
        <span>Описание</span>
        <textarea name="description" rows="5" maxlength="700"></textarea>
